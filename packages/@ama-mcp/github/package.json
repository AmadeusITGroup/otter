{
  "name": "@ama-mcp/github",
  "version": "0.0.0-placeholder",
  "publishConfig": {
    "access": "public"
  },
  "description": "Experimental package — This module provides a set of MCP tools to retrieve information from GitHub",
  "keywords": [
    "mcp",
    "github",
    "otter",
    "otter-module"
  ],
  "module": "src/public_api.ts",
  "typings": "./src/public_api.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "typings": "./dist/src/public_api.d.ts",
      "require": "./dist/src/public_api.js",
      "default": "./src/public_api.ts"
    }
  },
  "scripts": {
    "nx": "nx",
    "ng": "yarn nx",
    "build": "yarn nx build ama-mcp-github",
    "compile": "tsc -b ./tsconfig.build.json && yarn cpy package.json dist && patch-package-json-main"
  },
  "peerDependencies": {
    "@ama-mcp/core": "workspace:^",
    "@modelcontextprotocol/server": "^2.0.0",
    "@octokit/rest": "^22.0.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@ama-mcp/core": "workspace:^",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/platform-browser-dynamic": "~22.1.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.0",
    "@modelcontextprotocol/server": "~2.0.0",
    "@nx/eslint": "~23.1.0",
    "@nx/eslint-plugin": "~23.1.0",
    "@nx/js": "~23.1.0",
    "@nx/vitest": "~23.1.0",
    "@o3r/build-helpers": "workspace:^",
    "@o3r/eslint-config": "workspace:^",
    "@o3r/eslint-plugin": "workspace:^",
    "@octokit/rest": "~22.0.0",
    "@stylistic/eslint-plugin": "~5.10.0",
    "@types/node": "~24.13.0",
    "@typescript-eslint/parser": "~8.67.0",
    "@vitest/coverage-istanbul": "^4.0.18",
    "angular-eslint": "~22.1.0",
    "cpy-cli": "^6.0.0",
    "eslint": "~9.39.0",
    "eslint-import-resolver-node": "~0.4.0",
    "eslint-import-resolver-typescript": "~4.4.0",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-import-newlines": "~1.4.0",
    "eslint-plugin-jsdoc": "~61.7.0",
    "eslint-plugin-prefer-arrow": "~1.2.3",
    "eslint-plugin-unicorn": "~62.0.0",
    "eslint-plugin-unused-imports": "~4.4.0",
    "eslint-plugin-vitest": "~0.5.0",
    "globals": "^16.0.0",
    "jsonc-eslint-parser": "~2.4.0",
    "nx": "~23.1.0",
    "rxjs": "^7.8.1",
    "type-fest": "^5.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.67.0",
    "vitest": "~4.1.0",
    "zod": "~4.4.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  }
}
