{
  "name": "@ama-sdk/mcp",
  "version": "0.0.0-placeholder",
  "publishConfig": {
    "access": "public"
  },
  "description": "Experimental package -- MCP module to expose SDK_CONTEXT.md from installed packages to AI assistants",
  "keywords": [
    "mcp",
    "sdk",
    "ai-context",
    "otter-module"
  ],
  "sideEffects": false,
  "bin": {
    "ama-sdk-mcp": "./dist/src/cli.js",
    "ama-sdk-mcp-start": "./dist/src/cli.js"
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    }
  },
  "scripts": {
    "nx": "nx",
    "ng": "yarn nx",
    "build": "yarn nx build ama-sdk-mcp",
    "compile": "tsc -b ./tsconfig.build.json",
    "copy:resources": "yarn cpy resources dist",
    "postbuild": "yarn cpy package.json dist && patch-package-json-main"
  },
  "dependencies": {
    "@ama-mcp/core": "workspace:~",
    "@modelcontextprotocol/server": "~2.0.0",
    "@o3r/telemetry": "workspace:~",
    "commander": "^14.0.0",
    "tslib": "^2.6.2",
    "zod": "~4.4.0"
  },
  "devDependencies": {
    "@ama-mcp/core": "workspace:~",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.0",
    "@modelcontextprotocol/server": "~2.0.0",
    "@nx/eslint": "~23.1.0",
    "@nx/eslint-plugin": "~23.1.0",
    "@nx/js": "~23.1.0",
    "@nx/vitest": "~23.1.0",
    "@o3r/build-helpers": "workspace:^",
    "@o3r/eslint-config": "workspace:^",
    "@o3r/eslint-plugin": "workspace:^",
    "@stylistic/eslint-plugin": "~5.10.0",
    "@types/node": "~24.13.0",
    "@typescript-eslint/parser": "~8.67.0",
    "@vitest/coverage-istanbul": "^4.0.18",
    "cpy-cli": "^6.0.0",
    "eslint": "~9.39.0",
    "eslint-import-resolver-node": "~0.4.0",
    "eslint-import-resolver-typescript": "~4.4.0",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-import-newlines": "~1.4.0",
    "eslint-plugin-jsdoc": "~61.7.0",
    "eslint-plugin-prefer-arrow": "~1.2.3",
    "eslint-plugin-unicorn": "~62.0.0",
    "eslint-plugin-unused-imports": "~4.4.0",
    "@vitest/eslint-plugin": "~1.0.0",
    "globals": "^16.0.0",
    "jsonc-eslint-parser": "~2.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.67.0",
    "vitest": "~4.1.0",
    "zod": "~4.4.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  }
}
