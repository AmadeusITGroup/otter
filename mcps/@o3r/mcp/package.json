{
  "name": "@o3r/mcp",
  "version": "0.0.0-placeholder",
  "publishConfig": {
    "access": "public"
  },
  "description": "Experimental package — This module provides a MCP Server",
  "keywords": [
    "mcp",
    "otter",
    "otter-module"
  ],
  "bin": {
    "o3r-mcp-start": "./dist/src/cli/index.js"
  },
  "main": "./dist/src/cli/index.js",
  "scripts": {
    "nx": "nx",
    "ng": "yarn nx",
    "build": "yarn nx build mcp",
    "copy:resources": "yarn cpy '../../../assets/gen-ai/**/*.md' dist/resources",
    "compile": "tsc -b ./tsconfig.build.json",
    "postbuild": "yarn cpy package.json dist && patch-package-json-main"
  },
  "dependencies": {
    "@ama-mcp/angular": "workspace:^",
    "@ama-mcp/core": "workspace:^",
    "@ama-mcp/github": "workspace:^",
    "@ama-mcp/otter": "workspace:^",
    "@modelcontextprotocol/server": "~2.0.0",
    "@o3r/telemetry": "workspace:~",
    "@octokit/rest": "~22.0.0",
    "tslib": "^2.6.2",
    "zod": "~4.4.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "~0.2200.4",
    "@angular-devkit/schematics": "~22.0.4",
    "@angular/cli": "~22.0.4",
    "@angular/common": "~22.0.4",
    "@angular/compiler": "~22.0.4",
    "@angular/compiler-cli": "~22.0.4",
    "@angular/core": "~22.0.4",
    "@angular/platform-browser": "~22.0.4",
    "@angular/platform-browser-dynamic": "~22.0.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.0",
    "@nx/eslint": "~23.1.0",
    "@nx/eslint-plugin": "~23.1.0",
    "@nx/js": "~23.1.0",
    "@nx/vitest": "~23.1.0",
    "@o3r/build-helpers": "workspace:~",
    "@o3r/eslint-config": "workspace:~",
    "@o3r/eslint-plugin": "workspace:~",
    "@stylistic/eslint-plugin": "~5.10.0",
    "@types/node": "~24.13.0",
    "@typescript-eslint/parser": "~8.67.0",
    "@vitest/coverage-istanbul": "^4.0.18",
    "angular-eslint": "~22.0.0",
    "cpy-cli": "^6.0.0",
    "eslint": "~9.39.0",
    "eslint-import-resolver-node": "~0.4.0",
    "eslint-import-resolver-typescript": "~4.4.0",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-import-newlines": "~1.4.0",
    "eslint-plugin-jsdoc": "~61.7.0",
    "eslint-plugin-prefer-arrow": "~1.2.3",
    "eslint-plugin-unicorn": "~62.0.0",
    "eslint-plugin-unused-imports": "~4.4.0",
    "eslint-plugin-vitest": "~0.5.0",
    "globals": "^16.0.0",
    "jsonc-eslint-parser": "~2.4.0",
    "nx": "~23.1.0",
    "rxjs": "^7.8.1",
    "type-fest": "^5.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.67.0",
    "vitest": "~4.1.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  }
}
